# Copy to .env (ignored by Git). The server loads it at startup; shell variables take precedence.
OPENAI_API_KEY=
# 1 enables model reasoning for the three agents; 0 keeps deterministic fallback.
CONTRA_LLM=1
CONTRA_MODEL=gpt-6-astra
# Most paid model calls per UTC day (each analysis uses up to 3); repeats of an identical input are cached.
CONTRA_LLM_DAILY_LIMIT=60
# Paid calls one account may trigger per day, so a single visitor cannot use the whole budget.
CONTRA_LLM_ACCOUNT_DAILY_LIMIT=9

# Local binding (defaults shown).
CONTRA_HOST=127.0.0.1
CONTRA_PORT=8000

# Hosted mode: accept these public hostnames, use Secure cookies and trust the proxy.
# CONTRA_PUBLIC=1
# CONTRA_HOST=0.0.0.0
# CONTRA_ALLOWED_HOSTS=contra.example.com
